# ==============================================================================
# GEO-Agentic Travel Automation Platform - Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to '.env' in your local environment.
# NEVER commit secret keys or production service role tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_BASE_URL=https://morn.kz
APP_NAME="MORN Travel Platform"
API_VERSION=v1

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & REALTIME PERSISTENCE
# ------------------------------------------------------------------------------
# Public anonymous key (safe for client-side JavaScript initialization)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here

# Secret Service Role Key (STRICTLY for serverless backend / migration scripts)
# DO NOT expose this key in client-side bundles or public endpoints!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Direct PostgreSQL connection string for DDL migrations & CLI tooling
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. TELEGRAM DISPATCH ENGINE & OPERATOR NOTIFICATIONS
# ------------------------------------------------------------------------------
# Telegram Bot API token for real-time lead and booking dispatching
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Primary channel/group Chat ID for incoming certified guide leads
TELEGRAM_DISPATCH_CHAT_ID=-1001234567890

# Emergency channel for system alerts, RLS violations, or webhook delivery failures
TELEGRAM_ALERT_CHAT_ID=-1009876543210

# ------------------------------------------------------------------------------
# 4. KASPI PAY DIRECT SETTLEMENT INTEGRATION
# ------------------------------------------------------------------------------
# Registered merchant ID for Kazakhstan fintech gateway deep-links
KASPI_PAY_MERCHANT_ID=pgjnodee
KASPI_PAY_BASE_URL=https://pay.kaspi.kz/pay

# HMAC secret key for verifying inbound payment confirmation callbacks
KASPI_WEBHOOK_SECRET_HMAC=your-256-bit-kaspi-hmac-secret-hex

# ------------------------------------------------------------------------------
# 5. GENERATIVE ENGINE OPTIMIZATION (GEO) & AI AGENT CONFIGURATION
# ------------------------------------------------------------------------------
# Enables /llms.txt, /llms-full.txt and /ai-catalog.json discovery endpoints
ENABLE_GEO_INGESTION=true

# Edge CDN Cache-Control TTL for static AI knowledge markdown files (in seconds)
GEO_CACHE_TTL_SECONDS=3600

# Open permission flag for verified AI search crawlers (GPTBot, PerplexityBot, ClaudeBot)
ALLOW_AI_CRAWLERS=true

# ------------------------------------------------------------------------------
# 6. SECURITY, RATE-LIMITING & CORS
# ------------------------------------------------------------------------------
# Secret key used for internal webhook payload HMAC SHA-256 signatures
INTERNAL_WEBHOOK_HMAC_SECRET=your-internal-webhook-hmac-secret-here

# Comma-separated list of allowed origins for API calls
ALLOWED_CORS_ORIGINS=https://morn.kz,https://www.morn.kz

# Maximum anonymous booking submissions allowed per client IP per hour
RATE_LIMIT_BOOKING_PER_HOUR=10

# ------------------------------------------------------------------------------
# 7. AGENTIC CI/CD & DEVELOPER TOOLING
# ------------------------------------------------------------------------------
# Strict AST syntax validation gate (node -c app.js) before build execution
STRICT_SYNTAX_GATE=true

# Enable dual-entry parity validation between app.js and index.html
ENFORCE_ZERO_DRIFT_AUDIT=true
